cabal-version:   3.0
name:            haskell-rogue-like
version:         0.1.0.0
synopsis:        Минимальный консольный rogue-like (MVP)
license:         NONE
author:          tigodan
build-type:      Simple
extra-source-files: GameGuide.txt

executable haskell-rogue-like
  main-is:             Main.hs
  hs-source-dirs:      app
  default-language:    Haskell2010
  ghc-options:         -Wall -Wcompat
  build-depends:
    base          >= 4.16 && < 4.21,
    containers    >= 0.6  && < 0.8,
    random        >= 1.2  && < 1.4,
    ansi-terminal >= 1.0 && < 1.2
